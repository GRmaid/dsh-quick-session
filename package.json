{
  "name": "dsh-quick-session",
  "version": "0.1.0",
  "description": "不指定工作区即可开始新会话：每个快捷会话拥有独立临时目录，不绑定任何项目。",
  "type": "module",
  "license": "MIT",
  "author": "GRmaid",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GRmaid/dsh-quick-session.git"
  },
  "homepage": "https://github.com/GRmaid/dsh-quick-session#readme",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "scratch"
  ],
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "main": "lib/entry.js",
  "exports": {
    ".": "./lib/entry.js",
    "./client": "./lib/client.js",
    "./host": "./lib/entry.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  }
}
